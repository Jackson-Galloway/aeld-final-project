#!/bin/sh
# S01aesdchar - load/unload the aesdchar driver

case "$1" in
	start)
		echo "Loading aesdchar"
		modprobe aesdchar
		major=$(awk '$2=="aesdchar" {print $1}' /proc/devices)
		if [ -n "$major" ]; then
			rm -f /dev/aesdchar
			mknod /dev/aesdchar c $major 0
		fi
		;;
	stop)
		echo "Unloading aesdchar"
		rmmod aesdchar
		rm -f /dev/aesdchar
		;;
	*)
		echo "Usage: $0 {start|stop}"
		exit 1
		;;
esac

exit 0
